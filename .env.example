# ===== Nevlan — variables opcionales (copiar a .env junto al proyecto)
# Nunca commits .env con secretos reales.

# OpenAI-compatible (solo si usas el asistente / vibe en modo cloud)
OPENAI_API_KEY=

# Preferencias por defecto
ARTHUROS_LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# One-shot reliability closure (default: orchestrador OFF — mismo runtime histórico)
ONE_SHOT_RELIABILITY_ENABLED=false
ONE_SHOT_PREFLIGHT_REQUIRED=true
ONE_SHOT_USE_LOP=true
ONE_SHOT_ALLOW_COB_PILOT=false
ONE_SHOT_ALLOW_TEL_SEP_PRIMARY=false
ONE_SHOT_REQUIRE_SAFE_TO_CONTINUE=true

# Reliability hardening program (helpers + reports; sin mega-capas nuevas)
RELIABILITY_HARDENING_ENABLED=false
RUNTIME_LATENCY_REPORT_ENABLED=false
PRODUCTION_TELEMETRY_ENABLED=false
MAGIC_UX_SANITIZE_RUNNER_STATUS=false

# Nevlan Beta privada (un toggle reversible — fuerza perfiles SAFE + métricas)
# NOTA FASE 0: en ENV=prod estos flags son FIJOS (ver nevlan_runtime_convergence.py).
# El .env no puede activar perfiles paralelos (Nevlan A vs B).
BETA_PRIVATE_RELIABILITY_PROFILE=false
BETA_PRIVATE_RUNTIME_PROFILE=false

# Pre-Click Operational Freeze — en prod: true fijo; en dev: auto ON por ENV=dev
PCOF_ENABLED=false
